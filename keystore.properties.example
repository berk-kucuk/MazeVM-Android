# Copy this to keystore.properties and fill it in. That file is git-ignored and must
# stay that way: together with the .jks it is the only thing proving an update to
# MazeVM came from you.
#
# Create the key first, choosing your own password:
#
#   keytool -genkeypair -v \
#     -keystore mazevm-release.jks \
#     -alias mazevm \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# Keep the .jks file and its password backed up somewhere you will still have in a few
# years. Android identifies an app by its signing key, so losing it means every future
# release has to be installed as a different app, and nobody gets an update.

storeFile=mazevm-release.jks
storePassword=
keyAlias=mazevm
keyPassword=
